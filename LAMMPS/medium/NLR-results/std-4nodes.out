  using 1 OpenMP thread(s) per MPI task
variable        run_name string "Medium NLR LAMMPS benchmark"
print           "--- Starting run: ${run_name} ---"
--- Starting run: Medium NLR LAMMPS benchmark ---

variable 	thermo_print equal 150
variable	total_step equal ${thermo_print}*10
variable	total_step equal 150*10

units		real
boundary	p p p
neighbor        2.0 bin
neigh_modify    delay 10 every 1
atom_style	full
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
pair_style      lj/cut/coul/long 10.0
pair_modify     mix arithmetic
kspace_style    pppm 1e-4
read_data       ../data.begin
